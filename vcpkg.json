{
  "name": "cemu",
  "version-string": "1.0",
  "builtin-baseline": "f0fb3ddba5135b80982668de39dbaa139c00d281",
  "dependencies": [
    "pugixml",
    "zlib",
    "zstd",
    {
      "name": "libzip",
      "default-features": false
    },
    "rapidjson",
    {
      "name": "sdl3",
      "default-features": false,
      "features": [
        {
          "name": "x11",
          "platform": "linux"
        },
        {
          "name": "vulkan",
          "platform": "linux"
        }
      ]
    },
    "boost-tokenizer",
    "boost-container",
    "boost-program-options",
    "boost-nowide",
    "boost-algorithm",
    "boost-functional",
    "boost-optional",
    "boost-signals2",
    "boost-asio",
    "boost-ptr-container",
    "boost-property-tree",
    "boost-static-string",
    "boost-random",
    {
      "name": "fmt",
      "version>=": "12.1.0"
    },
    "libpng",
    "glm",
    {
      "name": "glslang",
      "default-features": false
    },
    "zstd",
    "openssl",
    {
      "name": "curl",
      "default-features": false,
      "features": [
        "openssl"
      ]
    },
    {
      "name": "dbus",
      "default-features": false,
      "platform": "linux"
    },
    {
      "name": "tiff",
      "default-features": false,
      "features": [
        "jpeg",
        "zip"
      ]
    },
    "libusb"
  ],
  "features": {
    "wxwidgets": {
      "description": "The wxWidgets front end (ENABLE_WXWIDGETS)",
      "dependencies": [
        {
          "name": "wxwidgets",
          "default-features": false,
          "features": [
            "debug-support"
          ]
        }
      ]
    },
    "sdl-wayland": {
      "description": "SDL's Wayland backend, for a build without the wxWidgets front end",
      "dependencies": [
        {
          "name": "sdl3",
          "default-features": false,
          "features": [
            {
              "name": "wayland",
              "platform": "linux"
            }
          ]
        }
      ]
    }
  },
  "overrides": [
    {
      "name": "glslang",
      "version": "15.1.0"
    },
    {
      "name": "sdl3",
      "version": "3.4.10"
    },
    {
      "name": "wxwidgets",
      "version": "3.3.3"
    }
  ]
}
